{
  "name": "sindrawer-google-slides",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome extension that turns SinDrawer sine-wave art into Google Slides backgrounds in one click",
  "type": "module",
  "license": "BSL-1.0",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "vue-tsc --noEmit && vite build --config vite.config.ts",
    "watch": "vite build --config vite.config.ts --watch --mode development",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "vue-tsc --noEmit",
    "icons": "node Scripts/GenerateIcons.mjs"
  },
  "packageManager": "pnpm@10.20.0",
  "dependencies": {
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.6",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  }
}
